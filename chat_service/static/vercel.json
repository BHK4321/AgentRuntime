{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://agentos-backend-gota.onrender.com/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/:path*"
    }
  ]
}
