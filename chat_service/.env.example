# AgentOS HTTP interface (not its gRPC address).
AGENTOS_INTERFACE_URL=http://127.0.0.1:8000
# Optional bearer token for an authenticated gateway in front of AgentOS.
AGENTOS_INTERFACE_TOKEN=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
# Choose an available cloud model that supports tool calling; use its API name.
OLLAMA_MODEL=gpt-oss:20b
